---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Abrany" description="Contact us today!">
  <section class="contact-hairlines pt-[50px] pb-6" data-ps="src/pages/contact.astro:contact-main">
    <div class="mx-auto max-w-[980px] px-5 lg:px-0" data-ps="src/pages/contact.astro:uoopef">
      <h1 class="font-heading text-[2.5rem] leading-[1.3] tracking-[1px] text-primary md:text-[50px] md:leading-[65px] mb-10" data-ps="src/pages/contact.astro:xwwf0u">We are listening</h1>

      <div class="max-w-[980px] text-[15px] leading-[21px] text-foreground" data-ps="src/pages/contact.astro:lx8n1r">
        <p data-ps="src/pages/contact.astro:wmga0i">At <span class="text-primary" data-ps="src/pages/contact.astro:lvpf9s">Abrany</span>, we are dedicated to delivering exceptional solutions tailored to your unique needs. Whether you're looking to collaborate on a project, explore innovative strategies, or simply learn more about how we can support your business, we’re here to help.</p>
        <p class="mt-[21px]" data-ps="src/pages/contact.astro:wmga0h">Our team of experts is committed to understanding your challenges, uncovering opportunities, and providing insights that drive meaningful results. By fostering strong partnerships, we aim to empower your organization to achieve its goals and unlock its full potential in an ever-evolving world.</p>
        <p class="mt-[21px]" data-ps="src/pages/contact.astro:wmga0g">We value open communication and look forward to hearing from you. Reach out to us today to start a conversation about how Abrany can support your success.</p>
      </div>

      <div class="mt-10 lg:grid lg:grid-cols-[516px_1fr] lg:gap-[44px]" data-ps="src/pages/contact.astro:lx8n1q">
        <div class="lg:pl-6" data-ps="src/pages/contact.astro:lx8n1p">
          <h2 class="text-[25px] leading-[37.5px] font-light text-black" data-ps="src/pages/contact.astro:j8hht9">Contact us</h2>

          <form id="contact-form" aria-label="Contact Form" class="mt-[29px] flex flex-col gap-[22px]">
            <input type="hidden" name="_formId" value="contact" />

            <div class="grid gap-[22px] sm:grid-cols-2 sm:gap-x-6" data-ps="src/pages/contact.astro:lx8n1o">
              <div class="flex flex-col" data-ps="src/pages/contact.astro:lx8n1n">
                <label for="contact-first-name" class="mb-1 text-[15px] leading-5 text-black" data-ps="src/pages/contact.astro:zcrbyf">First name <span aria-hidden="true" data-ps="src/pages/contact.astro:lvpfae">*</span></label>
                <input id="contact-first-name" name="firstName" type="text" required autocomplete="given-name"
                  class="h-10 w-full border-0 border-b-2 border-black bg-transparent px-0 text-[15px] text-black focus:outline-2 focus:outline-offset-2 focus:outline-primary" />
              </div>
              <div class="flex flex-col" data-ps="src/pages/contact.astro:lx8n1m">
                <label for="contact-last-name" class="mb-1 text-[15px] leading-5 text-black" data-ps="src/pages/contact.astro:zcrbye">Last name</label>
                <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name"
                  class="h-10 w-full border-0 border-b-2 border-black bg-transparent px-0 text-[15px] text-black focus:outline-2 focus:outline-offset-2 focus:outline-primary" />
              </div>
            </div>

            <div class="flex flex-col" data-ps="src/pages/contact.astro:lx8n1l">
              <label for="contact-email" class="mb-1 text-[15px] leading-5 text-black" data-ps="src/pages/contact.astro:zcrbyd">Email <span aria-hidden="true" data-ps="src/pages/contact.astro:lvpfaf">*</span></label>
              <input id="contact-email" name="email" type="email" required autocomplete="email"
                class="h-10 w-full border-0 border-b-2 border-black bg-transparent px-0 text-[15px] text-black focus:outline-2 focus:outline-offset-2 focus:outline-primary" />
            </div>

            <div class="flex flex-col" data-ps="src/pages/contact.astro:lx8n1k">
              <label for="contact-message" class="mb-1 text-[15px] leading-5 text-black" data-ps="src/pages/contact.astro:zcrbyc">Write a message</label>
              <textarea id="contact-message" name="message" rows="3"
                class="h-[100px] w-full resize-y border-0 border-b-2 border-black bg-transparent px-0 py-1 text-[15px] text-black focus:outline-2 focus:outline-offset-2 focus:outline-primary"></textarea>
            </div>

            <altcha-widget
              challenge="/psapi-internal-v1/altcha/challenge"
              display="invisible"
              auto="onfocus"
            ></altcha-widget>

            <div data-ps="src/pages/contact.astro:lx8n1j">
              <button id="contact-submit" type="submit"
                class="inline-flex h-[41px] w-[148px] items-center justify-center rounded-full bg-black text-[16px] text-white hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60" data-ps="src/pages/contact.astro:qxoibz">
                Submit
              </button>
            </div>

            <p id="contact-status" role="status" aria-live="polite" class="hidden text-[15px] leading-5" data-ps="src/pages/contact.astro:wmga0f"></p>
          </form>
        </div>

        <div class="mt-10 text-[16px] leading-[22.4px] text-foreground lg:mt-0 lg:pt-[4px]" data-ps="src/pages/contact.astro:lx8n1i">
          <p data-ps="src/pages/contact.astro:wmga0e">Visit us: 240 Plashet Grove, Eest Ham, London, United Kingdom E61DQ</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-hairlines {
      background-color: transparent;
      background-image: url("https://pagesmith-cdn.com/b8f1e60d/images/89a094_0f0b2afe86bb4895819977cfece78a3d~mv2-4d6e34-983.webp");
      background-size: auto;
      background-position: 50% 50%;
      background-repeat: repeat;
    }
  </style>

  <script>
    import 'altcha';

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-status') as HTMLParagraphElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

    const showStatus = (message: string, tone: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.className = `text-[15px] leading-5 ${tone === 'success' ? 'text-primary' : 'text-red-700'}`;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitBtn) return;

      submitBtn.disabled = true;
      const data = new FormData(form);
      const firstName = String(data.get('firstName') ?? '').trim();
      const lastName = String(data.get('lastName') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _formId: 'contact',
            name: `${firstName} ${lastName}`.trim(),
            firstName,
            lastName,
            email,
            message,
            altcha: data.get('altcha'),
          }),
        });
        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          form.reset();
          showStatus('Thank you! Your message has been sent.', 'success');
        } else {
          throw new Error(result.error || 'Your message could not be sent. Please try again.');
        }
      } catch (err) {
        showStatus(err instanceof Error ? err.message : 'Your message could not be sent. Please try again.', 'error');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</BaseLayout>
